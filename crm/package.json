{
  "name": "turners-decks-crm",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=development vite dev --port 3000",
    "build": "vite build",
    "preview": "CLOUDFLARE_ENV=development npm run build && vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --silent=passed-only",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env development",
    "cf-typegen": "wrangler types --strict-vars=false",
    "generate-routes": "tsr generate",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && wrangler deploy",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.575.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.2",
    "@cloudflare/vitest-plugin": "1.4.1",
    "@tanstack/router-cli": "1.167.43",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "seroval": "1.6.9",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.150.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "fsevents@2.3.3": true
  }
}
