# Build-time settings for the public site (copy to .env locally; set in Cloudflare Pages for deploys).
# Both are public: Astro inlines PUBLIC_* values into the page.

# Base URL of the CRM (crm/), no trailing slash. Both forms post to <PUBLIC_CRM_URL>/api/public/intake and the
# estimator loads its questions from <PUBLIC_CRM_URL>/api/public/estimator. The site's origin must be in the CRM's
# INTAKE_ALLOWED_ORIGINS.
PUBLIC_CRM_URL=http://localhost:3000

# Cloudflare Turnstile site key for the forms' security check (the CRM holds the matching secret).
# 1x00000000000000000000AA is Cloudflare's always-pass test key, for local development only.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
