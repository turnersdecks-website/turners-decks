---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import FinancingBlock from "@/components/sections/FinancingBlock.astro";
import Estimator from "@/components/islands/Estimator";
import { SITE } from "@/lib/site";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import Faq from "@/components/sections/Faq.astro";
import Button from "@/components/Button.astro";
import { faqSchema } from "@/lib/seo";
import Photo from "@/components/sections/Photo.astro";
import { PHOTO } from "@/lib/photos";
import { ArrowUpDown, Fence, Footprints, Hammer, Layers, ListChecks, MapPin, Ruler, Tag } from "@lucide/astro";

const steps = [
  { icon: ListChecks, title: "Answer six quick questions", body: "Pick from photos and simple choices. No measuring tape needed." },
  { icon: Tag, title: "See your price range", body: "Based on real decks we've built in Berks, Montgomery, and Chester Counties." },
  { icon: MapPin, title: "Get a free on-site quote", body: "It's a planning tool, not a quote. When you're ready, we measure and confirm the price." },
];
const asks = [
  { icon: Hammer, label: "Type of project" },
  { icon: Ruler, label: "Rough size" },
  { icon: Layers, label: "Decking material" },
  { icon: ArrowUpDown, label: "Height off the ground" },
  { icon: Fence, label: "Railings" },
  { icon: Footprints, label: "Stairs" },
];

const faqs = [
  { q: "How accurate is the online estimate?", a: "It gives a realistic preliminary range for early budgeting. Your final price comes from a free on-site quote, where we measure and look at site conditions, structure, access, and permit requirements." },
  { q: "What affects the price of a deck the most?", a: "Size, decking material, how high the deck sits off the ground, railings, and stairs. Site access, existing conditions, and township requirements matter too." },
  { q: "Does the range include permits?", a: "The range includes a standard permit allowance. We handle the permit application, township approval, and inspections for you." },
  { q: "Does it include removing my old deck?", a: "If you tell the estimator you're replacing a deck, removal and disposal of the old deck are included in the range." },
  { q: "What happens after I get my range?", a: "If you send us your answers, our team reaches out to book a free on-site quote. Want to talk sooner? Call or text us any time." },
  { q: "Do you offer financing?", a: "Yes, through Acorn Finance. Checking your rate won't affect your credit score." },
];
---

<BaseLayout
  title="Deck Price Estimator | Turner's Decks"
  description="Plan your deck budget. Answer a few questions about size, materials, railings, and stairs to see a realistic preliminary price range from Turner's Decks."
  chip="call"
  schema={faqSchema(faqs)}
>
  <PageHero eyebrow="Price estimator" title="Deck price estimator">
    <p class="text-sm">Rather talk it through? <a href={SITE.phoneHref} class="link">Call {SITE.phone}</a></p>
  </PageHero>
  <section class="bg-secondary">
    <div class="container-site py-10 md:py-14">
      {/* The intro, questions and prices come from the CRM's Published version (the island loads them). */}
      <Estimator client:load />
      <div class="mt-8"><FinancingBlock level={2} /></div>
    </div>
  </section>

  <!-- How it works: three steps, then the six things it asks about -->
  <section class="section container-site">
    <div class="max-w-2xl">
      <p class="eyebrow mb-2.5">How it works</p>
      <h2 class="display-2">A realistic range in a couple of minutes</h2>
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="relative rounded-3xl bg-secondary p-7">
          <div class="flex items-center gap-3">
            <span class="flex size-11 items-center justify-center rounded-full bg-primary text-white" aria-hidden="true"><s.icon class="size-5" /></span>
            <span class="eyebrow">Step {i + 1}</span>
          </div>
          <h3 class="mt-5 text-[1.375rem] font-medium leading-snug text-primary">{s.title}</h3>
          <p class="mt-2 text-muted-foreground">{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-12 rounded-3xl border border-border p-7">
      <p class="eyebrow">What it asks about</p>
      <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-6">
        {asks.map((a) => (
          <li class="flex items-center gap-3 font-medium text-primary">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-secondary" aria-hidden="true"><a.icon class="size-5" /></span>
            {a.label}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Questions beside a photo -->
  <section class="section bg-secondary">
    <div class="container-site grid gap-12 lg:grid-cols-[5fr_7fr]">
      <div>
        <p class="eyebrow mb-2.5">Questions</p>
        <h2 class="display-2">Good to know</h2>
        <Photo photo={PHOTO.compositeBorder} sizes="(min-width: 1024px) 40vw, 100vw" class="mt-8 hidden aspect-[4/3] w-full rounded-3xl object-cover lg:block" />
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/deck-materials-guide" variant="outline" size="lg">Compare Materials</Button>
          <Button href="/gallery" variant="outline" size="lg">See Our Projects</Button>
        </div>
      </div>
      <div class="lg:pt-2"><Faq faqs={faqs} /></div>
    </div>
  </section>
</BaseLayout>
