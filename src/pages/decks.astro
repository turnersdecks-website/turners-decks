---
// /decks: the old site's hub page ("Our Decks"), now also the Services hub.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Photo from "@/components/sections/Photo.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import ServiceCards from "@/components/sections/ServiceCards.astro";
import FinancingBlock from "@/components/sections/FinancingBlock.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { PHOTO } from "@/lib/photos";
import { PROJECT_LIST } from "@/lib/old-pages";

const KINDS = [
  {
    title: "Composite and PVC Decks",
    photo: PHOTO.brownComposite,
    items: [
      ["Color & texture options", "Composite and PVC boards come in many colors and textures, so you can match your siding and trim."],
      ["Design flexibility", "Composite works for curves, inlays, and patterned borders."],
      ["Accessories & enhancements", "Add railings, lighting, and other extras that match the boards."],
    ],
  },
  {
    title: "Wood Decks",
    photo: PHOTO.mahoganyPorch,
    items: [
      ["Natural appearance", "Wood has a warm, classic look and real grain."],
      ["Material options", "Pressure-treated lumber, cedar, and mahogany differ in price, lifespan, and look."],
      ["Custom details", "Railings, stairs, and built-ins can be styled to match your house."],
    ],
  },
  {
    title: "Pool & Elevated Decks",
    photo: PHOTO.ptPool[1],
    items: [
      ["Structural design", "We frame elevated and pool decks to handle height changes, slopes, and multi-level layouts."],
      ["Safety features", "Railings, gates, and slip-resistant boards make the deck safer around the pool and up high."],
      ["Integrated access", "Stairs and landings connect the house, the yard, and the pool."],
    ],
  },
  {
    title: "Covered Decks & Porches",
    photo: PHOTO.coveredPorch,
    items: [
      ["Weather protection", "A roof gives shade and keeps the rain off, so you can use the deck on more days."],
      ["Roof integration", "The roof can tie into your existing roofline or stand on its own."],
      ["Added comfort", "A finished ceiling, lights, fans, or heaters let you use it in spring and fall too."],
    ],
  },
];
---

<BaseLayout
  title="Our Deck Projects | Custom Decks | Deck Builder in Berks County, PA"
  description="Custom composite and wood decks we've designed and built for homes across Berks, Montgomery, and Chester Counties, Pennsylvania."
>
  <PageHero
    photo={PHOTO.limerick[0]}
    eyebrow="Our Decks"
    title="Composite, PVC, and Wood Decks"
    intro="Turner’s Decks designs and builds custom decks in composite, PVC, and wood for homeowners throughout Southeastern Pennsylvania."
  />

  <section class="section container-site"><ServiceCards level={2} /></section>

  {
    KINDS.map((k, i) => (
      <section class:list={["section", { "bg-secondary": i % 2 === 0 }]}>
        <div class="container-site split">
          <div class:list={{ "md:order-2": i % 2 === 1 }}>
            <h2 class="display-2">{k.title}</h2>
            <ul class="mt-8 grid gap-5">
              {k.items.map(([label, text]) => (
                <li class="text-[1.0625rem] leading-relaxed text-muted-foreground">
                  <span class="font-medium text-primary">{label}:</span> {text}
                </li>
              ))}
            </ul>
            {i === 0 && <Button href="/contact" variant="outline" size="lg" class="mt-8">Contact Us for More Details</Button>}
          </div>
          <Photo photo={k.photo} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
        </div>
      </section>
    ))
  }

  <section class="section container-site">
    <SectionHeading eyebrow="Project spotlights" title="Recent decks, start to finish" />
    <div class="mt-10 grid gap-7 md:grid-cols-3">
      {PROJECT_LIST.map((p) => (
        <a href={`/${p.slug}`} class="group block">
          <Photo photo={p.hero} class="aspect-[4/3] w-full rounded-2xl object-cover" />
          <p class="mt-4 text-xl font-medium leading-snug text-primary group-hover:underline">{p.card}</p>
        </a>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/gallery" variant="outline" size="lg">See More Photos</Button>
      <Button href="/deck-materials-guide" variant="outline" size="lg">Deck Materials Guide</Button>
    </div>
    <div class="mt-12"><FinancingBlock /></div>
  </section>

  <CtaBand />
</BaseLayout>
