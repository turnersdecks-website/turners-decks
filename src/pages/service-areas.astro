---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import ServiceAreasList from "@/components/sections/ServiceAreasList.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import StepList from "@/components/sections/StepList.astro";
import Photo from "@/components/sections/Photo.astro";
import { PERMIT_STEPS } from "@/lib/site";
import { PHOTO } from "@/lib/photos";
---

<BaseLayout
  title="Service Areas: Berks, Montgomery & Chester County"
  description="Turner's Decks builds decks within about 30 miles of Douglassville, PA, including Pottstown, Limerick, Collegeville, Reading, West Chester, and more."
>
  <PageHero eyebrow="Service areas" title="Where we build" intro="Based in Douglassville, we build decks within about 30 miles across Berks, Montgomery, and Chester Counties." />
  <section class="section container-site">
    <ServiceAreasList level={2} />
    <p class="mt-12 text-muted-foreground">We also build in nearby communities like Phoenixville and Wyomissing. Don't see your town? If you're within about 30 miles of Douglassville, reach out and we'll tell you if we can get there.</p>
  </section>

  <section class="section bg-secondary">
    <div class="container-site split">
      <div class="max-w-3xl">
        <SectionHeading eyebrow="Southeastern Pennsylvania" title="Building decks across Berks, Montgomery, and Chester Counties" />
        <p class="mt-6 text-[1.0625rem] leading-relaxed text-muted-foreground">
          Our shop is in the Douglassville area, and we regularly build decks throughout Berks, Montgomery, and Chester Counties. We handle design, permits, and construction the same way whether you live five minutes away or half an hour out.
        </p>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted-foreground">
          Every township and borough has its own permit office, zoning rules, and inspection schedule, and many neighborhoods have HOA guidelines too. We work with them all the time, so you don't have to figure out setbacks, drawings, or inspection dates on your own.
        </p>
      </div>
      <Photo photo={PHOTO.limerick[9]} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
    </div>
  </section>

  <section class="section container-site">
    <SectionHeading eyebrow="Permits" title="How we handle your township's permit" />
    <div class="mt-8 max-w-3xl"><StepList steps={PERMIT_STEPS} /></div>
  </section>
  <CtaBand />
</BaseLayout>
