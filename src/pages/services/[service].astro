---
// /services/new-decks, /services/deck-replacement, /services/pool-decks
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Photo from "@/components/sections/Photo.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import StepList from "@/components/sections/StepList.astro";
import Materials from "@/components/sections/Materials.astro";
import FinancingBlock from "@/components/sections/FinancingBlock.astro";
import QuoteForm from "@/components/islands/QuoteForm";
import { PERMIT_STEPS, SERVICES, SITE, type ServiceSlug } from "@/lib/site";
import { SERVICE_CONTENT } from "@/lib/services";
import { PHOTO, SERVICE_IMAGES } from "@/lib/photos";

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { service: s.slug } }));
}

const slug = Astro.params.service as ServiceSlug;
const c = SERVICE_CONTENT[slug];
---

<BaseLayout title={c.metaTitle} description={c.metaDesc}>
  <PageHero photo={SERVICE_IMAGES[slug]} eyebrow="Services" title={c.h1} intro={c.intro} note={`Your request goes to ${SITE.ownerFirst}, not a sales team.`}>
    <Button href="#quote" variant="light" size="lg">Get a Free Estimate</Button>
    <Button href="/estimator" variant="outline-light" size="lg">Try the Price Estimator</Button>
  </PageHero>

  <section class="section container-site split">
    <Photo photo={SERVICE_IMAGES[slug]} alt={c.title} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
    <div>
      <SectionHeading eyebrow={c.title} title="What's included" />
      <ol class="mt-8 grid gap-3 text-[1.1875rem] font-medium leading-snug">
        {c.points.map((p, i) => (
          <li class="flex items-baseline gap-3.5">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full border-[1.5px] border-current text-sm text-primary" aria-hidden="true">{i + 1}</span>
            {p}
          </li>
        ))}
      </ol>
      <Button href="/gallery" variant="outline" size="lg" class="mt-8">See Our Projects</Button>
    </div>
  </section>

  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="Materials" title="Pick what fits your budget" />
      <div class="mt-12"><Materials /></div>
      <div class="mt-12"><FinancingBlock /></div>
    </div>
  </section>

  <section class="section container-site split">
    <div>
      <SectionHeading eyebrow="Permits" title="We handle the permit, start to finish" />
      <div class="mt-8"><StepList steps={PERMIT_STEPS} /></div>
    </div>
    <Photo photo={PHOTO.framing} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
  </section>

  <section id="quote" class="section on-dark scroll-mt-4 bg-primary">
    <div class="container-site split items-start">
      <div>
        <h2 class="display-2">Get a free on-site estimate</h2>
        <p class="mb-8 mt-4 text-[1.1875rem] leading-normal text-muted-foreground">No pressure, no sales pitch.</p>
        <QuoteForm client:visible onDark defaultProject={c.formValue} />
      </div>
      <Photo photo={PHOTO.compositeBorder} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
    </div>
  </section>
</BaseLayout>
