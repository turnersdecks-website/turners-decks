---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import ServiceCards from "@/components/sections/ServiceCards.astro";
import Materials from "@/components/sections/Materials.astro";
import FinancingBlock from "@/components/sections/FinancingBlock.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
---

<BaseLayout
  title="Deck Building Services"
  description="New decks, deck replacement, and pool decks in composite, capped PVC, and pressure-treated wood. Serving Berks, Montgomery, and Chester Counties, PA."
>
  <PageHero eyebrow="Services" title="Deck building services" intro="We build new decks, replace old ones, and build pool decks. Every job includes permits, handled start to finish." />
  <section class="section container-site"><ServiceCards level={2} /></section>
  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="Materials" title="Composite, capped PVC, or wood" />
      <div class="mt-12"><Materials /></div>
      <p class="mt-10 text-base text-muted-foreground">Have an old deck that needs work? We don't do repairs or staining, but we can replace it with a new deck that lasts.</p>
      <div class="mt-8"><FinancingBlock /></div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
