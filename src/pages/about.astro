---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import WhyUsGrid from "@/components/sections/WhyUsGrid.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import ContentBlock from "@/components/sections/ContentBlock.astro";
import Photo from "@/components/sections/Photo.astro";
import Button from "@/components/Button.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { PHOTO } from "@/lib/photos";
import { SITE } from "@/lib/site";
import type { Block } from "@/lib/old-pages";

// Story copy adapted from the old site's About page (founder story kept; no promise that Pat
// personally runs every job, since the plan is to move him out of the field).
const options: Block[] = [
  {
    heading: "Composite and PVC decking",
    body: ["Composite brands like Trex and TimberTech hold their color and never need staining. They suit families who want a deck that lasts without yearly upkeep."],
  },
  {
    heading: "Wood decking",
    body: ["Pressure-treated lumber holds up well and costs the least. Cedar and mahogany cost more and have a warmer, natural look."],
  },
  {
    heading: "Railings",
    body: ["Aluminum, composite, cable, or vinyl, in modern or traditional styles to match your house."],
  },
  {
    heading: "Deck lighting",
    body: ["Step lights, post-cap lights, or built-in LED lighting, so you can see the stairs and use the deck after dark."],
  },
];
---

<BaseLayout
  title="About Turner's Decks | Local Custom Deck Builder"
  description="Turner's Decks was founded in 2018 by professional carpenter Pat Turner in Douglassville, PA. New decks, replacements, and pool decks, permits handled."
>
  <PageHero photo={PHOTO.elevatedStairs} eyebrow="Why us · About" title="A local deck company, started by a carpenter" intro={`${SITE.owner} founded Turner's Decks in Douglassville in ${SITE.since}. We build decks, and that's all we do.`} />

  <section class="section container-site split items-start">
    <div class="max-w-3xl">
      <SectionHeading eyebrow="Our story" title="About Turner's Decks" />
      <p class="mt-6 text-[1.0625rem] leading-relaxed text-muted-foreground">
        Turner's Decks is a locally owned deck building company based in Douglassville, PA, founded by professional carpenter {SITE.owner}. After years as a general contractor, he chose to design and build only decks, the part of the work he enjoys most.
      </p>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted-foreground">
        We build with composite, PVC, pressure-treated lumber, and hardwood, and we design each deck around the house and how you plan to use it.
      </p>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted-foreground">
        We frame to code, finish cleanly, and handle the permit from application to final inspection. From the first conversation to the final walkthrough, you talk to the people building your deck, with no sales team in the middle.
      </p>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted-foreground">
        We build for homeowners throughout Berks, Montgomery, and Chester Counties.
      </p>
    </div>
    <Photo photo={PHOTO.limerick[2]} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
  </section>

  <section class="section bg-secondary">
    <div class="container-site">
      <WhyUsGrid title="What sets us apart" cta={{ href: "/our-process", label: "See Our Process" }} />
    </div>
  </section>

  <section class="section container-site">
    <SectionHeading
      eyebrow="Materials & options"
      title="Built with materials that fit your home"
      intro="We'll walk you through each choice, from boards to railings to lighting, and help you weigh looks, upkeep, and budget."
    />
    <div class="mt-12 grid gap-10 md:grid-cols-2">
      {options.map((b) => <ContentBlock block={b} />)}
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/deck-materials-guide" variant="outline" size="lg">Deck Materials Guide</Button>
      <Button href="/gallery" variant="outline" size="lg">See Our Projects</Button>
    </div>
  </section>

  <section class="section bg-secondary">
    <div class="container-site split">
      <div>
        <SectionHeading eyebrow="What to expect" title="Working with us" />
        <ul class="mt-8 grid gap-3 text-[1.0625rem] leading-snug">
          {[
            "Straight answers from the first conversation",
            "A design that fits your house and how you use the yard",
            "Materials picked to last",
            "Permits, drawings, and inspections handled for you",
            "A clean job site",
            `A 12-month workmanship warranty, plus manufacturer warranties on materials`,
          ].map((t) => (
            <li class="flex items-baseline gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />{t}</li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-muted-foreground">PA Home Improvement Contractor #{SITE.hic}</p>
      </div>
      <Photo photo={PHOTO.coveredPorch} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
