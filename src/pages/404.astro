---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Page not found" description="That page doesn't exist or has moved." noindex>
  <div class="flex min-h-[60vh] items-center justify-center px-4">
    <div class="max-w-md text-center">
      <h1 class="text-7xl font-bold">404</h1>
      <h2 class="mt-4 text-xl font-semibold">Page not found</h2>
      <p class="mt-2 text-sm text-muted-foreground">That page doesn't exist or has moved.</p>
      <Button href="/" class="mt-6">Go home</Button>
    </div>
  </div>
</BaseLayout>
