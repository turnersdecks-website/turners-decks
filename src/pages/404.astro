---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import PageHero from "@/components/sections/PageHero.astro";
---

<BaseLayout title="Page not found" description="That page doesn't exist or has moved." noindex>
  <PageHero tall eyebrow="404" title="Page not found" intro="That page doesn't exist or has moved.">
    <Button href="/" variant="light" size="lg">Go home</Button>
    <Button href="/gallery" variant="outline-light" size="lg">See Our Projects</Button>
  </PageHero>
</BaseLayout>
