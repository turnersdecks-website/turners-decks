---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Photo from "@/components/sections/Photo.astro";
import QuoteForm from "@/components/islands/QuoteForm";
import { PHOTO } from "@/lib/photos";
import { SITE } from "@/lib/site";
import { localBusinessSchema } from "@/lib/seo";
---

<BaseLayout
  title="Get a Free Deck Estimate"
  description="Request a free on-site deck estimate from Turner's Decks in Douglassville, PA. Serving Berks, Montgomery, and Chester Counties."
  schema={localBusinessSchema()}
  chip="call"
>
  <section class="on-dark bg-navy-deep">
    <div class="container-site split items-start pb-[clamp(4rem,8vw,6.5rem)] pt-[calc(var(--header-h)+clamp(2rem,5vw,4rem))]">
      <div>
        <p class="eyebrow mb-4 text-white">Contact</p>
        <h1 class="display-1">Get a free estimate</h1>
        <p class="mb-8 mt-5 text-[1.1875rem] leading-normal text-muted-foreground">Tell us about your project and we'll set up a free on-site visit. Your request goes to {SITE.ownerFirst}, not a sales team.</p>
        <QuoteForm client:load onDark />
      </div>
      <div>
        <Photo photo={PHOTO.groundComposite} sizes="(min-width: 900px) 50vw, 100vw" eager class="aspect-[4/3] w-full rounded-3xl object-cover" />
        <dl class="divided mt-8 text-base md:grid-flow-row md:[&>*]:border-l-0 md:[&>*]:border-t md:[&>*]:px-0 md:[&>*]:py-4 md:[&>:first-child]:border-t-0 md:[&>:first-child]:pt-0">
          <div><dt class="eyebrow">Call or text</dt><dd class="flex flex-wrap gap-x-4"><a href={SITE.phoneHref} class="link inline-flex min-h-11 items-center">{SITE.phoneVanity} ({SITE.phone})</a><a href={SITE.smsHref} class="link inline-flex min-h-11 items-center">Send a text</a></dd></div>
          <div><dt class="eyebrow">Email</dt><dd><a href={`mailto:${SITE.email}`} class="link inline-flex min-h-11 items-center break-all">{SITE.email}</a></dd></div>
          <div><dt class="eyebrow">Where we build</dt><dd class="mt-1">{SITE.city}, {SITE.state}, serving Berks, Montgomery & Chester Counties</dd></div>
          <div><dt class="eyebrow">Hours</dt><dd class="mt-1">{SITE.hours}</dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
