---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import { SITE } from "@/lib/site";
---

<BaseLayout title="Privacy Policy" description="How Turner's Decks collects and uses the information you share through our website.">
  <PageHero title="Privacy Policy"><Fragment /></PageHero>
  <section class="section container-site">
    {/* [CONTENT] have this reviewed before launch, then add "Last updated: <date>" here */}
    <div class="max-w-3xl space-y-6 text-muted-foreground">
      <p>When you request an estimate or use our price estimator, we collect your name, email, phone number, zip code, and project details.</p>
      <p>We use this information only to contact you about your project. We don't sell your information.</p>
      <p>Questions? Contact us at {SITE.email} or {SITE.phone}.</p>
    </div>
  </section>
</BaseLayout>
