---
import { ArrowRight, Calculator, Phone } from "@lucide/astro";
import { Picture } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Photo from "@/components/sections/Photo.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import ServiceCards from "@/components/sections/ServiceCards.astro";
import WhyUsGrid from "@/components/sections/WhyUsGrid.astro";
import BeforeAfterSlider from "@/components/sections/BeforeAfterSlider.astro";
import EstimatorBanner from "@/components/sections/EstimatorBanner.astro";
import ServiceAreasList from "@/components/sections/ServiceAreasList.astro";
import GoogleReviews from "@/components/sections/GoogleReviews.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { HERO, PHOTO } from "@/lib/photos";
import { localBusinessSchema } from "@/lib/seo";
import { SITE } from "@/lib/site";
---

<BaseLayout
  title="Deck Builder in Douglassville, PA | Turner's Decks"
  description="New decks, deck replacement, and pool decks in Berks, Montgomery, and Chester Counties. Locally owned, permits handled. Get a free on-site estimate."
  schema={localBusinessSchema()}
>
  <section class="relative isolate overflow-hidden">
    <Picture
      src={HERO.src}
      alt={HERO.alt}
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      formats={["webp"]}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="hero-overlay absolute inset-0 -z-10"></div>
    <div class="container-site py-10 md:py-14">
      <p class="eyebrow text-primary-foreground/80">Douglassville, PA · Since {SITE.since}</p>
      <h1 class="mt-3 max-w-lg text-4xl font-bold leading-tight text-primary-foreground md:text-5xl">
        Decks built right, permits handled.
      </h1>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-primary-foreground/85 md:text-lg">
        New decks, replacements, and pool decks across Berks, Montgomery, and Chester Counties. Built by carpenters, with every permit handled for you.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/contact" variant="light" size="lg">Get a Free Estimate <ArrowRight aria-hidden="true" /></Button>
        <Button href="/estimator" variant="outline-light" size="lg"><Calculator aria-hidden="true" /> Try the Price Estimator</Button>
      </div>
      <p class="mt-4 text-base text-primary-foreground/85">
        Rather talk it through? <a href={SITE.phoneHref} class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-primary-foreground underline underline-offset-4 hover:no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><Phone class="size-4" aria-hidden="true" />Call {SITE.phone}</a>
      </p>
      <a href="/gallery" class="group mt-7 inline-flex max-w-full items-center gap-4 rounded-md text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
        <span class="flex shrink-0 gap-2">
          {[PHOTO.groundComposite, PHOTO.replacementDeck, PHOTO.poolDeck].map((photo) => (
            <Photo photo={photo} sizes="96px" class="h-14 w-16 rounded-sm object-cover sm:h-16 sm:w-24" />
          ))}
        </span>
        <span class="text-sm font-semibold leading-snug">Our Projects <ArrowRight class="mt-1 size-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true" /></span>
      </a>
    </div>
  </section>

  <section class="section container-site">
    <SectionHeading eyebrow="What we build" title="Three things, done well" />
    <div class="mt-10"><ServiceCards /></div>
  </section>

  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="Why Turner's Decks" title="Built by carpenters, not a sales team" />
      <div class="mt-10"><WhyUsGrid /></div>
    </div>
  </section>

  <section class="section container-site">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Before & after" title="From worn out to built to last" intro="Drag the slider to see a tired wood deck replaced with low-maintenance composite." />
        <Button href="/gallery" variant="cta" size="lg" class="mt-8">See More Projects</Button>
      </div>
      <BeforeAfterSlider before={PHOTO.replacementBefore2} after={PHOTO.replacementSkirt} alt="Deck replacement" />
    </div>
  </section>

  <section class="container-site pb-16 md:pb-24"><EstimatorBanner /></section>

  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="Service areas" title="Within about 30 miles of Douglassville" />
      <div class="mt-10"><ServiceAreasList /></div>
    </div>
  </section>

  <section class="section container-site">
    <SectionHeading eyebrow="Reviews" title="What customers say" center />
    <div class="mt-10"><GoogleReviews /></div>
  </section>

  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="How it works" title="Our process, in four steps" />
      <div class="mt-10"><ProcessSteps /></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
