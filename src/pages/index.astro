---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Photo from "@/components/sections/Photo.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import ServiceColumns from "@/components/sections/ServiceColumns.astro";
import ProjectCards from "@/components/sections/ProjectCards.astro";
import WhyUsGrid from "@/components/sections/WhyUsGrid.astro";
import BeforeAfterSlider from "@/components/sections/BeforeAfterSlider.astro";
import EstimatorBanner from "@/components/sections/EstimatorBanner.astro";
import ServiceAreasList from "@/components/sections/ServiceAreasList.astro";
import GoogleReviews from "@/components/sections/GoogleReviews.astro";
import StepList from "@/components/sections/StepList.astro";
import QuoteForm from "@/components/islands/QuoteForm";
import { HERO, PHOTO } from "@/lib/photos";
import { localBusinessSchema } from "@/lib/seo";
import { PROCESS_STEPS, SITE } from "@/lib/site";
---

<BaseLayout
  title="Deck Builder in Douglassville, PA | Turner's Decks"
  description="New decks, deck replacement, and pool decks in Berks, Montgomery, and Chester Counties. Locally owned, permits handled. Get a free on-site estimate."
  schema={localBusinessSchema()}
>
  <PageHero
    tall
    photo={HERO}
    eyebrow={`Deck builder · ${SITE.city}, ${SITE.state} · Since ${SITE.since}`}
    title="Decks built right, permits handled."
    intro="New decks, replacements, and pool decks across Berks, Montgomery, and Chester Counties. Built by carpenters, with every permit handled for you."
    note={`Your request goes to ${SITE.ownerFirst}, not a sales team.`}
  >
    <Button href="#estimate" variant="light" size="lg">Get a Free Estimate</Button>
    <Button href="/estimator" variant="outline-light" size="lg">Try the Price Estimator</Button>
  </PageHero>

  <section class="section container-site">
    <SectionHeading eyebrow="What we build" title="Three things, done well" />
    <div class="mt-12"><ServiceColumns /></div>
  </section>

  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="Recent decks" title="Real decks from real backyards" />
      <div class="mt-12"><ProjectCards /></div>
    </div>
  </section>

  <section class="section container-site">
    <div class="split">
      <div>
        <SectionHeading eyebrow="Before and after" title="From worn out to built to last" intro="Drag the slider to see a tired wood deck replaced with low-maintenance composite." />
        <Button href="/gallery" variant="outline" size="lg" class="mt-8">See More Projects</Button>
      </div>
      <BeforeAfterSlider before={PHOTO.replacementBefore2} after={PHOTO.replacementSkirt} alt="Deck replacement" />
    </div>
  </section>

  <section class="section on-dark bg-navy-deep">
    <div class="container-site">
      <div class="mb-12"><SectionHeading title="What customers say" /></div>
      <GoogleReviews dark />
    </div>
  </section>

  <section class="section container-site">
    <WhyUsGrid eyebrow="Why us" title="Built by carpenters, not a sales team" cta={{ href: "/about", label: "About Turner's Decks" }} />
  </section>

  <section class="section bg-secondary">
    <div class="container-site split">
      <div>
        <SectionHeading eyebrow="How it works" title="Our process, in four steps" />
        <div class="mt-8"><StepList steps={PROCESS_STEPS} /></div>
      </div>
      <Photo photo={PHOTO.elevated} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
    </div>
  </section>

  <section class="section container-site"><EstimatorBanner /></section>

  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="Where we build" title="Within about 30 miles of Douglassville" />
      <div class="mt-12"><ServiceAreasList /></div>
    </div>
  </section>

  <section id="estimate" class="section on-dark scroll-mt-4 bg-primary">
    <div class="container-site split items-start">
      <div>
        <h2 class="display-2">Ready for a new deck?</h2>
        <p class="mb-8 mt-4 text-[1.1875rem] leading-normal text-muted-foreground">Get a free on-site estimate. No pressure, no sales pitch.</p>
        <QuoteForm client:visible onDark />
      </div>
      <Photo photo={PHOTO.compositeNew} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
    </div>
  </section>
</BaseLayout>
