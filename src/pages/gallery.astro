---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import BeforeAfterSlider from "@/components/sections/BeforeAfterSlider.astro";
import Photo from "@/components/sections/Photo.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { PHOTO, PROJECTS } from "@/lib/photos";
import { PROJECT_LIST } from "@/lib/old-pages";

const pairs = PROJECTS.filter((p) => p.before && p.after);
const withPhotos = PROJECTS.filter((p) => p.photos.length);
---

<BaseLayout
  title="Our Projects: Deck Gallery"
  description="Real decks built by Turner's Decks: composite pool decks, deck replacements, ground-level composite decks, and elevated pressure-treated decks, with before-and-after photos."
>
  <PageHero photo={PHOTO.replacementAfter} eyebrow="Our projects" title="Recent decks we've built" intro="Real projects from across Berks, Montgomery, and Chester Counties." />
  <section class="section container-site">
    <div class="max-w-3xl">
      <p class="text-[1.0625rem] leading-relaxed text-muted-foreground">
        Every photo here is a deck our team built: new decks, deck replacements, and pool decks in composite, PVC, and pressure-treated wood. You'll see the details that come standard on our decks, like picture-frame borders, joist protection tape, and color-matched or white fascia, plus the railings and stairs homeowners chose to finish them off.
      </p>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted-foreground">
        Want to know what a deck like one of these would cost? Try the <a href="/estimator" class="link">price estimator</a> for a preliminary range, or read the project spotlights below for sizes and cost ranges on three recent builds.
      </p>
    </div>
  </section>
  <section class="section container-site">
    <SectionHeading eyebrow="Before & after" title="See the difference" intro="Drag each slider to compare." />
    <div class="mt-12 grid gap-x-7 gap-y-10 lg:grid-cols-2">
      {pairs.map((p) => (
        <figure>
          <BeforeAfterSlider before={p.before!} after={p.after!} alt={p.title} />
          <figcaption class="mt-4">
            <p class="eyebrow">{p.type}</p>
            <p class="mt-1 text-xl font-medium leading-snug text-primary">{p.title}</p>
            {p.blurb && <p class="mt-2 text-muted-foreground">{p.blurb}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="Project spotlights" title="The full story, with sizes and cost ranges" />
      <div class="mt-10 grid gap-7 md:grid-cols-3">
        {PROJECT_LIST.map((p) => (
          <a href={`/${p.slug}`} class="group block">
            <Photo photo={p.hero} class="aspect-[4/3] w-full rounded-2xl object-cover" />
            <p class="eyebrow mt-4">{p.glance.range}</p>
            <p class="mt-1 text-xl font-medium leading-snug text-primary group-hover:underline">{p.card}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  {withPhotos.map((p, i) => (
    <section class:list={["section", { "bg-secondary": i % 2 === 1 }]}>
      <div class="container-site">
        <SectionHeading eyebrow={p.type} title={p.title} intro={p.before && p.after ? (p.more ?? "More photos from this project.") : p.blurb} />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {p.photos.map((ph) => <Photo photo={ph} class="aspect-[4/3] w-full rounded-2xl object-cover" />)}
        </div>
      </div>
    </section>
  ))}
  <CtaBand title="Like what you see?" />
</BaseLayout>
