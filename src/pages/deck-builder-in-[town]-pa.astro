---
// One page per town in the TOWNS list; adding a town is a data change in lib/site.ts.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Photo from "@/components/sections/Photo.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import PageHero from "@/components/sections/PageHero.astro";
import StepList from "@/components/sections/StepList.astro";
import ServiceCards from "@/components/sections/ServiceCards.astro";
import Faq from "@/components/sections/Faq.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { PHOTO } from "@/lib/photos";
import { PERMIT_STEPS, SITE, TOWNS } from "@/lib/site";
import { townFaqs } from "@/lib/services";
import { faqSchema, localBusinessSchema } from "@/lib/seo";

export function getStaticPaths() {
  return TOWNS.map((town) => ({ params: { town: town.slug }, props: { town } }));
}

const { town } = Astro.props;
const faqs = townFaqs(town.name);
---

<BaseLayout
  title={`Deck Builder in ${town.name}, PA`}
  description={`Locally owned deck builder serving ${town.name}, ${town.county} County. New decks, deck replacement, and pool decks with permits handled. Free on-site estimates.`}
  schema={[localBusinessSchema([`${town.name}, PA`]), faqSchema(faqs)]}
>
  <PageHero
    photo={PHOTO.compositeNew}
    eyebrow={`${town.county} County`}
    title={`Deck Builder in ${town.name}, PA`}
    intro={`Turner's Decks builds new decks, replaces old ones, and builds pool decks for homeowners in ${town.name}. Founded by professional carpenter ${SITE.owner}, we handle the permit from start to finish.`}
    note="Your request goes straight to our team."
  >
    <Button href="/contact" variant="light" size="lg">Get a Free Estimate</Button>
    <Button href="/estimator" variant="outline-light" size="lg">Try the Price Estimator</Button>
  </PageHero>

  <section class="section container-site split">
    <div>
      <SectionHeading eyebrow="Permits" title={`Deck Permits in ${town.name}`} intro="Here's how we handle the permit for your deck, in four steps." />
      <div class="mt-8"><StepList steps={PERMIT_STEPS} /></div>
      {/* [CONTENT] town-specific permit notes (township office, typical timeline) */}
    </div>
    <Photo photo={PHOTO.framing} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
  </section>

  <section class="section bg-secondary">
    <div class="container-site">
      <SectionHeading eyebrow="What we build" title="Decks We Build" />
      <div class="mt-12"><ServiceCards /></div>
    </div>
  </section>

  <section class="section container-site">
    <SectionHeading eyebrow="Local experience" title="Local Experience" intro={`We've been building decks around Douglassville since ${SITE.since}, and ${town.name} is well within our regular service area.`} />
    {/* [CONTENT] local details, neighborhoods, or notes about building in this town */}
    <h2 class="mt-16 text-[clamp(1.5rem,2.6vw,2rem)]">Recent Projects</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {[PHOTO.replacementSkirt, PHOTO.groundComposite, PHOTO.poolDeck].map((p) => <Photo photo={p} class="aspect-square w-full rounded-2xl object-cover" />)}
    </div>
  </section>

  <section class="section bg-secondary">
    <div class="container-site">
      <div class="max-w-3xl">
        <SectionHeading eyebrow="Questions" title={`${town.name} FAQs`} />
        <Faq faqs={faqs} />
      </div>
    </div>
  </section>

  <CtaBand title={`Planning a deck in ${town.name}?`} />
</BaseLayout>
