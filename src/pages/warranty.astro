---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import CtaBand from "@/components/sections/CtaBand.astro";

const items = [
  { title: "12-month workmanship warranty", body: "Covers our work on your deck for the first 12 months after the build." },
  { title: "Manufacturer warranties up to 50 years", body: "Decking materials carry their own manufacturer warranty. Length depends on the material you choose." },
];
---

<BaseLayout
  title="Deck Warranty"
  description="Every Turner's Decks build includes a 12-month workmanship warranty, plus manufacturer material warranties of up to 50 years."
>
  <PageHero eyebrow="Why us · Warranty" title="We stand behind our work" intro="Two layers of coverage on every deck." />
  <section class="section container-site">
    <div class="divided">
      {items.map(({ title, body }) => (
        <div>
          <h2 class="text-[clamp(1.5rem,2.6vw,2rem)]">{title}</h2>
          <p class="mt-3 text-muted-foreground">{body}</p>
        </div>
      ))}
    </div>
    {/* [CONTENT] full warranty terms */}
  </section>
  <CtaBand />
</BaseLayout>
