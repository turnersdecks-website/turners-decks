---
import Logo from "./Logo.astro";
import { SITE, SERVICES } from "@/lib/site";

const company = [
  ["About", "/about"],
  ["Our Process", "/our-process"],
  ["Warranty", "/warranty"],
  ["Reviews", "/reviews"],
  ["Our Projects", "/gallery"],
  ["Service Areas", "/service-areas"],
];
const linkCls = "inline-flex min-h-9 items-center hover:underline";
---

<footer class="on-dark bg-navy-deep text-[0.9375rem]">
  <div class="container-site grid gap-10 py-16 sm:grid-cols-2 md:grid-cols-4">
    <div>
      <Logo light />
      <p class="mt-4 text-muted-foreground">
        Locally owned deck building in Berks, Montgomery, and Chester Counties since {SITE.since}.
      </p>
    </div>
    <div>
      <h2 class="eyebrow">Services</h2>
      <ul class="mt-3">
        {SERVICES.map((s) => <li><a href={`/services/${s.slug}`} class={linkCls}>{s.title}</a></li>)}
        <li><a href="/estimator" class={linkCls}>Price Estimator</a></li>
      </ul>
    </div>
    <div>
      <h2 class="eyebrow">Company</h2>
      <ul class="mt-3">
        {company.map(([label, href]) => <li><a href={href} class={linkCls}>{label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="eyebrow">Contact</h2>
      <ul class="mt-3">
        <li><a href={SITE.phoneHref} class={linkCls}>{SITE.phone}</a></li>
        <li><a href={`mailto:${SITE.email}`} class={linkCls}>{SITE.email}</a></li>
        <li class="py-1.5 text-muted-foreground">{SITE.city}, {SITE.state}</li>
        <li class="py-1.5 text-muted-foreground">Hours: {SITE.hours}</li>
      </ul>
    </div>
  </div>
  <div class="border-t">
    {/* Bottom padding keeps the HIC number and privacy link clear of the floating chip. */}
    <div class="container-site flex flex-col gap-2 pb-24 pt-5 text-sm text-muted-foreground sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name}. All rights reserved. · PA HIC #{SITE.hic}</p>
      <a href="/privacy-policy" class="hover:underline">Privacy Policy</a>
    </div>
  </div>
</footer>
