---
// White-on-navy header that lies over the top of each page's hero (see BaseLayout).
import { ChevronDown, Menu, X } from "@lucide/astro";
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import { SITE } from "@/lib/site";

const NAV = [
  {
    label: "Services",
    to: "/services",
    children: [
      { label: "New Decks", to: "/services/new-decks" },
      { label: "Deck Replacement", to: "/services/deck-replacement" },
      { label: "Pool Decks", to: "/services/pool-decks" },
    ],
  },
  { label: "Our Projects", to: "/gallery" },
  { label: "Price Estimator", to: "/estimator" },
  { label: "Service Areas", to: "/service-areas" },
  {
    label: "Why Us",
    to: "/about",
    children: [
      { label: "About", to: "/about" },
      { label: "Our Process", to: "/our-process" },
      { label: "Warranty", to: "/warranty" },
      { label: "Reviews", to: "/reviews" },
    ],
  },
  { label: "Contact", to: "/contact", mobileOnly: true },
];

const path = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1") || "/";
---

<header class="on-dark absolute inset-x-0 top-0 z-40">
  <div class="container-site flex h-(--header-h) items-center justify-between gap-6">
    <a href="/" aria-label="Turner's Decks home"><Logo light eager /></a>

    <nav class="hidden items-center gap-7 text-[0.9375rem] font-medium lg:flex" aria-label="Main">
      {
        NAV.filter((item) => !item.mobileOnly).map((item) =>
          item.children ? (
            <div class="group relative">
              <a href={item.to} class="flex min-h-11 items-center gap-1 whitespace-nowrap hover:underline">
                {item.label} <ChevronDown class="size-3.5" aria-hidden="true" />
              </a>
              <div class="invisible absolute -left-3 top-full min-w-52 rounded-2xl bg-popover p-2 text-primary opacity-0 shadow-card transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {item.children.map((c) => (
                  <a href={c.to} class="block rounded-lg px-3 py-2.5 hover:bg-secondary">
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.to}
              class:list={["flex min-h-11 items-center whitespace-nowrap underline-offset-4 hover:underline", { underline: path === item.to }]}
              aria-current={path === item.to ? "page" : undefined}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <Button href="/contact" variant="light" class="hidden sm:inline-flex">Get a Free Estimate</Button>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full text-white hover:bg-white/10 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Menu class="size-6" data-icon="open" />
        <X class="hidden size-6" data-icon="close" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t bg-navy-deep shadow-card lg:hidden">
    <nav class="container-site flex flex-col py-4" aria-label="Mobile">
      {
        NAV.map((item) => (
          <div>
            <a href={item.to} class="block py-3 text-lg font-medium">
              {item.label}
            </a>
            {item.children?.map((c) => (
              <a href={c.to} class="block py-2.5 pl-4 text-base text-muted-foreground">
                {c.label}
              </a>
            ))}
          </div>
        ))
      }
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <Button href="/contact" variant="light" size="lg">Get a Free Estimate</Button>
        <Button href={SITE.phoneHref} variant="outline-light" size="lg">Call {SITE.phone}</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    panel?.classList.toggle("hidden", !open);
    toggle.querySelector("[data-icon=open]")?.classList.toggle("hidden", open);
    toggle.querySelector("[data-icon=close]")?.classList.toggle("hidden", !open);
  });
</script>
