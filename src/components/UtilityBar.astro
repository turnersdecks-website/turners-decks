---
// Thin navy bar above the header: where we work on the left, Pat's number on the right.
import { SITE } from "@/lib/site";
---

<div class="on-dark border-b border-white/10 bg-navy-deep text-[0.8125rem]">
  <div class="container-site flex items-center justify-between gap-4">
    <span class="hidden py-2.5 md:block">{SITE.city}, {SITE.state} · Berks, Montgomery and Chester Counties</span>
    <a href={SITE.phoneHref} class="inline-flex min-h-11 items-center font-medium hover:underline">Call or text {SITE.ownerFirst}: {SITE.phone}</a>
  </div>
</div>
