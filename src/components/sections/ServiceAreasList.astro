---
// Towns by county, as three columns with divider lines.
import { TOWNS, type County } from "@/lib/site";
const COUNTIES: County[] = ["Berks", "Montgomery", "Chester"];
interface Props { level?: 2 | 3 }
const { level = 3 } = Astro.props;
const H = `h${level}` as const;
---

<div class="divided">
  {
    COUNTIES.map((c) => (
      <div>
        <H class="text-2xl">{c} County</H>
        <ul class="mt-3">
          {TOWNS.filter((t) => t.county === c).map((t) => (
            <li>
              <a href={`/deck-builder-in-${t.slug}-pa`} class="inline-flex min-h-11 items-center text-base text-primary underline-offset-3 hover:underline">
                {t.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
