---
// The three service paths as columns with divider lines between them.
import { SERVICES } from "@/lib/site";
---

<div class="divided">
  {
    SERVICES.map((s) => (
      <div>
        <h3 class="text-2xl">{s.title}</h3>
        <p class="mt-3 text-base text-muted-foreground">{s.short}</p>
        <a href={`/services/${s.slug}`} class="link mt-3 inline-flex min-h-11 items-center">About {s.title.toLowerCase()}</a>
      </div>
    ))
  }
</div>
