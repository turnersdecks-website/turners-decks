---
// The three decking materials as columns with divider lines.
import { MATERIALS } from "@/lib/site";
---

<div class="divided">
  {
    MATERIALS.map((m) => (
      <div>
        <h3 class="text-2xl">{m.name}</h3>
        <p class="mt-3 text-base text-muted-foreground">{m.blurb}</p>
      </div>
    ))
  }
</div>
