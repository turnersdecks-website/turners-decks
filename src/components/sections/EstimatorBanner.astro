---
import { ArrowRight } from "@lucide/astro";
import Button from "@/components/Button.astro";
import Photo from "./Photo.astro";
import { PHOTO } from "@/lib/photos";
---

<div class="grid items-center gap-6 overflow-hidden rounded-xl border bg-secondary md:grid-cols-[minmax(0,18rem)_1fr_auto] md:gap-10 md:pr-10">
  <Photo photo={PHOTO.compositeBorder} sizes="(min-width: 768px) 18rem, 100vw" class="aspect-[16/9] h-full w-full object-cover md:aspect-auto" />
  <div class="px-6 md:px-0">
    <h2 class="text-2xl font-bold md:text-3xl">Wondering what it'll cost?</h2>
    <p class="mt-2 max-w-xl text-muted-foreground">
      Nine short steps, about 3 minutes, and you'll see a realistic price range for your deck.
    </p>
  </div>
  <div class="px-6 pb-6 md:p-0">
    <Button href="/estimator" variant="cta" size="lg">Try the Price Estimator <ArrowRight /></Button>
  </div>
</div>
