---
import Button from "@/components/Button.astro";
import Photo from "./Photo.astro";
import { PHOTO } from "@/lib/photos";
---

<div class="split">
  <Photo photo={PHOTO.compositeBorder} sizes="(min-width: 900px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-3xl object-cover" />
  <div>
    <p class="eyebrow mb-2.5">Price estimator</p>
    <h2 class="display-2">Wondering what it'll cost?</h2>
    <p class="mt-5 text-muted-foreground">
      Nine short steps, about 3 minutes, and you'll see a realistic price range for your deck.
    </p>
    <Button href="/estimator" variant="outline" size="lg" class="mt-8">Try the Price Estimator</Button>
  </div>
</div>
