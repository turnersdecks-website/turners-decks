---
// Native <details> accordion: works without JavaScript and stays crawlable.
import { ChevronDown } from "@lucide/astro";
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---

<div class="mt-6">
  {
    faqs.map((f) => (
      <details class="faq border-b" name="faq">
        <summary class="flex flex-1 cursor-pointer items-center justify-between py-4 text-left font-heading text-base font-medium text-primary transition-all hover:underline">
          {f.q}
          <ChevronDown class="faq-chevron h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200" />
        </summary>
        <div class="pb-4 pt-0 text-sm text-muted-foreground">{f.a}</div>
      </details>
    ))
  }
</div>
