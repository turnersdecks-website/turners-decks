---
import { PROCESS_STEPS } from "@/lib/site";
interface Props { level?: 2 | 3 }
const { level = 3 } = Astro.props;
const H = `h${level}` as const;
---

<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
  {
    PROCESS_STEPS.map((s, i) => (
      <li class="border-t-2 border-primary pt-5">
        <span class="font-heading text-sm font-semibold text-stone">Step {i + 1}</span>
        <H class="mt-1 text-lg font-semibold">{s.title}</H>
        <p class="mt-2 text-muted-foreground">{s.body}</p>
      </li>
    ))
  }
</ol>
