---
import Button from "@/components/Button.astro";
import { SITE } from "@/lib/site";
interface Props { title?: string; body?: string }
const { title = "Ready for a new deck?", body = "Get a free on-site estimate. No pressure, no sales pitch." } = Astro.props;
---

<section class="on-dark bg-primary">
  <div class="container-site section flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <h2 class="display-2">{title}</h2>
      <p class="mt-4 text-[1.1875rem] leading-normal text-muted-foreground">{body}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <Button href="/contact" variant="light" size="lg">Get a Free Estimate</Button>
      <Button href={SITE.phoneHref} variant="outline-light" size="lg">Call {SITE.phone}</Button>
      <Button href={SITE.smsHref} variant="outline-light" size="lg">Text us</Button>
    </div>
  </div>
</section>
