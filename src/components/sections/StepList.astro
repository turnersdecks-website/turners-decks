---
// Numbered list with outlined circles. One column beside a photo, or two across a full row.
interface Props { steps: { title: string; body: string }[]; columns?: 1 | 2 }
const { steps, columns = 1 } = Astro.props;
---

<ol class:list={["grid gap-x-12 gap-y-6", { "md:grid-cols-2": columns === 2 }]}>
  {
    steps.map((s, i) => (
      <li class="flex items-baseline gap-3.5">
        <span class="flex size-7 shrink-0 items-center justify-center rounded-full border-[1.5px] border-current text-sm font-medium text-primary [.on-dark_&]:text-white" aria-hidden="true">
          {i + 1}
        </span>
        <div>
          <h3 class="text-[1.1875rem] leading-snug tracking-normal">{s.title}</h3>
          <p class="mt-1 text-base text-muted-foreground">{s.body}</p>
        </div>
      </li>
    ))
  }
</ol>
