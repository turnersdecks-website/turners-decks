---
interface Props { steps: { title: string; body: string }[] }
const { steps } = Astro.props;
---

<ol class="grid gap-4 sm:grid-cols-2">
  {
    steps.map((s, i) => (
      <li class="flex gap-4 rounded-xl border bg-card p-5">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary font-heading font-semibold text-primary-foreground">
          {i + 1}
        </span>
        <div>
          <h3 class="font-semibold">{s.title}</h3>
          <p class="mt-1 text-sm text-muted-foreground">{s.body}</p>
        </div>
      </li>
    ))
  }
</ol>
