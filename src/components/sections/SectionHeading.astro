---
interface Props { eyebrow?: string; title: string; intro?: string; center?: boolean }
const { eyebrow, title, intro, center = false } = Astro.props;
---

<div class={center ? "mx-auto max-w-3xl text-center" : "max-w-3xl"}>
  {eyebrow && <p class="eyebrow mb-2.5">{eyebrow}</p>}
  <h2 class="display-2">{title}</h2>
  {intro && <p class="mt-5 text-muted-foreground">{intro}</p>}
</div>
