---
interface Props { eyebrow?: string; title: string; intro?: string; center?: boolean }
const { eyebrow, title, intro, center = false } = Astro.props;
---

<div class={center ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-bold md:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-lg text-muted-foreground">{intro}</p>}
</div>
