---
import Photo from "./Photo.astro";
import { SERVICES } from "@/lib/site";
import { SERVICE_IMAGES } from "@/lib/photos";
/** Heading level for card titles: 2 when the cards sit directly under the page h1. */
interface Props { level?: 2 | 3 }
const { level = 3 } = Astro.props;
const H = `h${level}` as const;
---

<div class="grid gap-x-7 gap-y-10 md:grid-cols-3">
  {
    SERVICES.map((s) => (
      <a href={`/services/${s.slug}`} class="group block">
        <Photo
          photo={SERVICE_IMAGES[s.slug]}
          alt={s.title}
          sizes="(min-width: 768px) 33vw, 100vw"
          class="aspect-[4/3] w-full rounded-2xl object-cover"
        />
        <H class="mt-5 text-2xl text-primary underline underline-offset-4 group-hover:decoration-2">{s.title}</H>
        <p class="mt-2 text-base text-muted-foreground">{s.short}</p>
      </a>
    ))
  }
</div>
